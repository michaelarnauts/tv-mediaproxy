From bf153533d41c0b1a73541de79afefe599694d075 Mon Sep 17 00:00:00 2001
From: tv-mediaproxy <noreply@localhost>
Date: Fri, 9 Oct 2026 21:01:34 +0000
Subject: [PATCH 1/4] cdcrypt: load the keys given with kids/keys

With keys given only on the command line (no cfile), cenc_dec_setup_cenc
returned before cenc_dec_load_keys, so the stream was decrypted with an
unset key for any MP4 input: the MP4 demuxer always declares the CENC_PSSH
property, with zero entries when there is no pssh box.
---
 src/filters/decrypt_cenc_isma.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/filters/decrypt_cenc_isma.c b/src/filters/decrypt_cenc_isma.c
index b1e66eb..1e2c497 100644
--- a/src/filters/decrypt_cenc_isma.c
+++ b/src/filters/decrypt_cenc_isma.c
@@ -1368,7 +1368,7 @@ static GF_Err cenc_dec_setup_cenc(GF_CENCDecCtx *ctx, GF_CENCDecStream *cstr, u3
 	}
 
 	if (ctx->keys.nb_items) {
-		return GF_OK;
+		return cenc_dec_load_keys(ctx, cstr);
 	}
 
 	cinfo_prop = gf_filter_pid_get_property(cstr->ipid, GF_PROP_PID_HLS_KMS);
