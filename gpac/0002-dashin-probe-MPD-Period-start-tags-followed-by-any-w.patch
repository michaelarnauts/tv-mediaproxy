From be18987a0e529a0dd2a61c5d76beeb518abda280 Mon Sep 17 00:00:00 2001
From: tv-mediaproxy <noreply@localhost>
Date: Fri, 9 Oct 2026 21:01:34 +0000
Subject: [PATCH 2/4] dashin: probe MPD/Period start tags followed by any
 whitespace

"<MPD" followed by a newline (as some packagers write it) was not
recognised and another demuxer was picked.
---
 src/filters/dmx_dash.c | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/filters/dmx_dash.c b/src/filters/dmx_dash.c
index e3578e2..b923f54 100644
--- a/src/filters/dmx_dash.c
+++ b/src/filters/dmx_dash.c
@@ -3561,6 +3561,19 @@ GF_Err dashdmx_process(GF_Filter *filter)
 	return GF_OK;
 }
 
+//locate an element start tag, the name being followed by any XML whitespace
+static char *dashdmx_probe_elt(const char *data, const char *tag)
+{
+	u32 len = (u32) strlen(tag);
+	char *res = strstr(data, tag);
+	while (res) {
+		char c = res[len];
+		if ((c==' ') || (c=='\t') || (c=='\r') || (c=='\n')) return res;
+		res = strstr(res+len, tag);
+	}
+	return NULL;
+}
+
 static const char *dashdmx_probe_data(const u8 *data, u32 size, GF_FilterProbeScore *score)
 {
 	char *d = (char *)data;
@@ -3568,8 +3581,8 @@ static const char *dashdmx_probe_data(const u8 *data, u32 size, GF_FilterProbeSc
 	char last_c = d[size-1];
 	d[size-1] = 0;
 	res_ghix = strstr(data, "<GHIX ");
-	res_dash = strstr(data, "<MPD ");
-	if (!res_dash) res_dash = strstr(data, "<Period ");
+	res_dash = dashdmx_probe_elt(data, "<MPD");
+	if (!res_dash) res_dash = dashdmx_probe_elt(data, "<Period");
 	res_m3u = strstr(data, "#EXTM3U");
 	res_smooth = strstr(data, "<SmoothStreamingMedia");
 	d[size-1] = last_c;
-- 
