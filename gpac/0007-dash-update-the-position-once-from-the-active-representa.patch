From: tv-mediaproxy <noreply@localhost>
Date: Sat, 10 Oct 2026 15:00:00 +0000
Subject: [PATCH 7/7] dash: update the position once, from the active
 representation's timeline

On a manifest update the segment position was merged once per
representation and once more for the AdaptationSet. Each merge mapped
the position the previous one had just set onto an old timeline, so a
window that moved by one segment moved the position once per
representation: the client went back and fetched segments again. When
the AdaptationSet and its representations carry different timelines, the
AdaptationSet's index, into a timeline the representations override,
won and pointed far past the end of the timeline in use: the client
waited forever. Merge once, on the timeline the active representation
uses.
---
 src/media_tools/dash_client.c | 15 +++++++--------
 1 file changed, 7 insertions(+), 8 deletions(-)

diff --git a/src/media_tools/dash_client.c b/src/media_tools/dash_client.c
index 03fb073..c75ab1c 100644
--- a/src/media_tools/dash_client.c
+++ b/src/media_tools/dash_client.c
@@ -3402,12 +3402,6 @@ process_m3u8_manifest:
 				}
 			}
 
-			e = gf_dash_merge_segment_timeline(group, NULL, rep->segment_list, rep->segment_template, new_rep->segment_list, new_rep->segment_template, timeline_start_time);
-			if (e) {
-				gf_mpd_del(new_mpd);
-				return e;
-			}
-
 			//move redirections in representations base URLs (we could do that on AS as well )
 			if (rep->base_URLs && new_rep->base_URLs) {
 				u32 k;
@@ -3449,9 +3443,14 @@ process_m3u8_manifest:
 			}
 		}
 
-		/*update segmentTimeline at AdaptationSet level before switching the set (old setup needed to compute current timing of each group) */
+		/*update the group position once, from the timeline the active representation uses (its own, else the AdaptationSet's), before switching the set (old setup needed to compute current timing of each group) */
 		if (new_set) {
-			e = gf_dash_merge_segment_timeline(group, NULL, set->segment_list, set->segment_template, new_set->segment_list, new_set->segment_template, timeline_start_time);
+			GF_MPD_Representation *rep = gf_list_get(set->representations, group->active_rep_index);
+			GF_MPD_Representation *new_rep = gf_list_get(new_set->representations, group->active_rep_index);
+			if ((rep->segment_list && rep->segment_list->segment_timeline) || (rep->segment_template && rep->segment_template->segment_timeline))
+				e = gf_dash_merge_segment_timeline(group, NULL, rep->segment_list, rep->segment_template, new_rep->segment_list, new_rep->segment_template, timeline_start_time);
+			else
+				e = gf_dash_merge_segment_timeline(group, NULL, set->segment_list, set->segment_template, new_set->segment_list, new_set->segment_template, timeline_start_time);
 			if (e) {
 				gf_mpd_del(new_mpd);
 				return e;
