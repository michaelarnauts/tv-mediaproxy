From 08d347929612d8957d91639e3a0a9ebbb7e061d3 Mon Sep 17 00:00:00 2001
From: Michael Arnauts <michael.arnauts@gmail.com>
Date: Thu, 15 Oct 2026 16:57:16 +0000
Subject: [PATCH] downloader: read the user agent from core:user-agent

The -user-agent option (short name -ua) is stored under its name,
core:user-agent, which the RTSP client and filter.c read. The HTTP
downloader read core:ua instead, so the option never reached HTTP
requests and GPAC's default agent name was always sent.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/utils/downloader.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/utils/downloader.c b/src/utils/downloader.c
index bd83b4d28..0b5c3d8f4 100644
--- a/src/utils/downloader.c
+++ b/src/utils/downloader.c
@@ -2899,7 +2899,7 @@ static GF_Err http_send_headers(GF_DownloadSession *sess) {
 			sprintf(pass_buf, "Basic %s", sess->creds->digest);
 	}
 
-	user_agent = gf_opts_get_key("core", "ua");
+	user_agent = gf_opts_get_key("core", "user-agent");
 	if (!user_agent) user_agent = GF_DOWNLOAD_AGENT_NAME;
 
 	sess->put_state = 0;
-- 
